@@ -1,16 +1,48 @@
 from PIL import Image
 from io import BytesIO
 import base64
+import math
+import os
 from openai import OpenAI, NOT_GIVEN
 from loguru import logger
 from tenacity import (
     retry,
+    stop_after_attempt,
     wait_random_exponential,
 )  # for exponential backoff
 
 
+_OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY")
+_OPENAI_BASE_URL = os.environ.get("OPENAI_BASE_URL") or None
+_REQUEST_TIMEOUT_SECONDS = float(os.environ.get("COMPLEX_EDIT_REQUEST_TIMEOUT_SECONDS", "60.0"))
+_SDK_MAX_RETRIES = int(os.environ.get("COMPLEX_EDIT_SDK_MAX_RETRIES", "0"))
+_REQUEST_MAX_ATTEMPTS = int(os.environ.get("COMPLEX_EDIT_REQUEST_MAX_ATTEMPTS", "3"))
+_RETRY_INITIAL_BACKOFF_SECONDS = float(
+    os.environ.get("COMPLEX_EDIT_RETRY_INITIAL_BACKOFF_SECONDS", "2.0")
+)
+_RETRY_MAX_BACKOFF_SECONDS = float(
+    os.environ.get("COMPLEX_EDIT_RETRY_MAX_BACKOFF_SECONDS", "30.0")
+)
+if not _OPENAI_API_KEY:
+    raise RuntimeError("OPENAI_API_KEY is required for Complex-Edit scoring")
+if not math.isfinite(_REQUEST_TIMEOUT_SECONDS) or _REQUEST_TIMEOUT_SECONDS <= 0:
+    raise RuntimeError("Complex-Edit request timeout must be finite and positive")
+if _SDK_MAX_RETRIES < 0:
+    raise RuntimeError("Complex-Edit SDK retries must be non-negative")
+if _REQUEST_MAX_ATTEMPTS <= 0:
+    raise RuntimeError("Complex-Edit request attempts must be positive")
+if (
+    not math.isfinite(_RETRY_INITIAL_BACKOFF_SECONDS)
+    or not math.isfinite(_RETRY_MAX_BACKOFF_SECONDS)
+    or _RETRY_INITIAL_BACKOFF_SECONDS < 0
+    or _RETRY_MAX_BACKOFF_SECONDS < _RETRY_INITIAL_BACKOFF_SECONDS
+):
+    raise RuntimeError("Complex-Edit retry backoff must be finite, non-negative, and capped")
 CLIENT_OPENAI = OpenAI(
-    api_key="<OPENAI_API_KEY>"
+    api_key=_OPENAI_API_KEY,
+    base_url=_OPENAI_BASE_URL,
+    timeout=_REQUEST_TIMEOUT_SECONDS,
+    max_retries=_SDK_MAX_RETRIES,
 )
 
 
