+def _canonical_json_bytes(value):
+    return json.dumps(
+        value,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def _sanitized_request_evidence(payload, *, endpoint, timeout_seconds):
+    content = payload["messages"][0]["content"]
+    text_records = []
+    image_records = []
+    for index, item in enumerate(content):
+        if item.get("type") == "text":
+            raw = str(item.get("text", "")).encode("utf-8")
+            text_records.append(
+                {"index": index, "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}
+            )
+        elif item.get("type") == "image_url":
+            url = str(item.get("image_url", {}).get("url", ""))
+            if url.startswith("data:") and ";base64," in url:
+                media_type, encoded = url.split(";base64,", 1)
+                raw = base64.b64decode(encoded, validate=True)
+                image_records.append(
+                    {
+                        "index": index,
+                        "media_type": media_type.removeprefix("data:"),
+                        "bytes": len(raw),
+                        "sha256": hashlib.sha256(raw).hexdigest(),
+                    }
+                )
+            else:
+                image_records.append(
+                    {
+                        "index": index,
+                        "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
+                    }
+                )
+    return {
+        "endpoint": endpoint,
+        "model": payload["model"],
+        "max_tokens": payload["max_tokens"],
+        "stream": payload["stream"],
+        "timeout_seconds": timeout_seconds,
+        "messages_sha256": hashlib.sha256(_canonical_json_bytes(payload["messages"])).hexdigest(),
+        "text_parts": text_records,
+        "image_parts": image_records,
+    }
+
