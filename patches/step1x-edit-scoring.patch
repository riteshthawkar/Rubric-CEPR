+def canonical_json_bytes(value):
+    return json.dumps(
+        value,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def publish_raw_response_exclusive(root, payload):
+    identity_raw = canonical_json_bytes(payload["identity"])
+    filename = hashlib.sha256(identity_raw).hexdigest() + ".json"
+    os.makedirs(root, mode=0o700, exist_ok=True)
+    final_path = os.path.join(root, filename)
+    raw = canonical_json_bytes(payload) + b"\n"
+    descriptor, temporary = tempfile.mkstemp(prefix=".raw-response-", dir=root)
+    try:
+        with os.fdopen(descriptor, "wb") as handle:
+            handle.write(raw)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.link(temporary, final_path)
+        directory_flags = os.O_RDONLY
+        if hasattr(os, "O_DIRECTORY"):
+            directory_flags |= os.O_DIRECTORY
+        directory_descriptor = os.open(root, directory_flags)
+        try:
+            os.fsync(directory_descriptor)
+        finally:
+            os.close(directory_descriptor)
+    except FileExistsError as exc:
+        raise RuntimeError(f"Raw response envelope already exists: {final_path}") from exc
+    finally:
+        try:
+            os.unlink(temporary)
+        except FileNotFoundError:
+            pass
+    return final_path
