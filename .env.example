# Copy values into your shell. Credentials are never bundled in the release.
# HF_HOME=/your/cache/huggingface
# RUBRIC_ROOT=/absolute/path/to/Rubric-CEPR
# RUBRIC_ENV_PREFIX=/absolute/path/to/model-environment
# RUBRIC_ACTIVATE_SCRIPT=/absolute/path/to/Rubric-CEPR/scripts/slurm/activate.example.sh
# OPENAI_API_KEY=your-private-api-key
# GEDIT_SECRET_ENV_PATH=/your/private/raw-key-file
# Do not override CUDA_VISIBLE_DEVICES assigned by Slurm.
